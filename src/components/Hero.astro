---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__art" aria-hidden="true">
    <div class="hero__canvas">
      <picture class="hero__base">
        <source media="(min-width: 1200px)" srcset={`${baseUrl}images/neon-hero-desktop.png`} width="2026" height="941" />
        <img src={`${baseUrl}images/neon-hero-mobile.png`} alt="" width="941" height="1672" fetchpriority="high" />
      </picture>
    </div>
  </div>
  <div class="container hero__content">
    <div class="hero__copy">
      <h1 id="hero-title">Seu próximo passo.<br />Seu cartão Neon.</h1>
      <p class="hero__description">Cartão de crédito sem anuidade, com a praticidade de acompanhar tudo pelo aplicativo.</p>
      <button class="hero__cta button-interaction" type="button" data-demo-open aria-haspopup="dialog" aria-controls="demo-modal">
        Começar solicitação
      </button>
      <p class="hero__legal">Crédito sujeito à análise. Demonstração de portfólio; nenhuma solicitação real será iniciada.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-art-offset: clamp(0px, calc(1560px - 400cqw), 120px);
    color: var(--color-text-inverse);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 40px;
  }
  .hero__copy {
    max-width: 685px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  h1 {
    font-size: var(--font-size-h1-mobile);
    line-height: 1.16;
    animation: hero-copy-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__description {
    margin-top: 22px;
    max-width: 504px;
    font-size: 1rem;
    line-height: 1.5;
    animation: hero-copy-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) 150ms both;
  }
  .hero__cta {
    margin-top: 26px;
    min-height: 56px;
    max-width: 100%;
    padding: 16px 24px;
    border: 0;
    border-radius: 100px;
    background: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    cursor: pointer;
    animation: hero-copy-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) 300ms both;
  }
  .hero__cta:active {
    box-shadow: inset 0 0 0 3px var(--color-brand-deep);
  }
  .hero__legal {
    margin-top: 14px;
    max-width: 393px;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 767px) {
    .hero__legal {
      display: none;
    }
  }

  /* Reserva espaço para a modelo após a copy. A dobra cresce com o texto,
     inclusive em zoom, sem impor uma altura fixa ao conteúdo. */
  .hero::after {
    content: "";
    display: block;
    height: calc(467 / 408 * (100cqw + 18px));
  }
  .hero__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  @media (max-width: 389px) {
    .hero__art {
      background: linear-gradient(to bottom, #2698fc, #0d6ed3 var(--hero-art-offset));
    }
  }
  .hero__canvas {
    position: absolute;
    top: var(--hero-art-offset);
    left: calc(-83 / 390 * 100cqw);
    width: calc(490 / 390 * 100cqw);
    height: calc(1190 / 390 * 100cqw);
  }
  .hero__base {
    position: absolute;
    inset: 0;
  }
  .hero__base img {
    position: absolute;
    top: 0;
    left: -7.62%;
    width: 111.2%;
    max-width: none;
    height: auto;
    object-fit: unset;
  }

  @media (max-width: 359px) {
    h1 {
      font-size: clamp(1.875rem, 9vw, 2.25rem);
    }
  }
  @media (min-width: 1200px) {
    .hero__content {
      padding-block: 168px 80px;
    }
    h1 {
      font-size: var(--font-size-h1-desktop);
      line-height: 1.12;
    }
    .hero__description {
      margin-top: 16px;
      font-size: 1.3125rem;
      line-height: 1.46;
    }
    .hero__cta {
      margin-top: 32px;
      min-height: 62px;
      padding-inline: 28px;
      font-size: 1.0625rem;
    }
    .hero__legal {
      margin-top: 24px;
      opacity: 0.94;
      animation: hero-legal-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) 450ms both;
    }
    .hero::after {
      display: none;
    }
    .hero__canvas {
      inset: 0;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      transform: none;
    }
    .hero__base img {
      position: absolute;
      top: -5.3%;
      right: clamp(-9.1cqw, calc((100cqw - 1920px) * 0.273), 0px);
      left: auto;
      width: max(100%, min(140.42cqw, 2026px));
      max-width: none;
      height: auto;
    }
  }

  @keyframes hero-legal-enter {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 0.94;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .hero__description,
    .hero__cta,
    .hero__legal {
      animation: none;
    }
  }
</style>
