---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__art" aria-hidden="true">
    <div class="final-cta__mobile-art">
      <div
        class="final-cta__mobile-reveal"
        data-scroll-reveal="final-cta-mobile-photo"
        style="--final-cta-reveal-y: 24px; --final-cta-reveal-duration: 750ms"
      >
        <img src={`${baseUrl}images/neon-final-cta-mobile.webp`} alt="" width="432" height="954" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="final-cta__desktop-art">
      <div
        class="final-cta__desktop-reveal"
        data-scroll-reveal="final-cta-desktop-photo"
        style="--final-cta-reveal-y: 24px; --final-cta-reveal-duration: 850ms"
      >
        <div class="final-cta__desktop-photo">
          <img src={`${baseUrl}images/neon-final-cta-desktop.webp`} alt="" width="2274" height="1402" loading="lazy" decoding="async" />
        </div>
        <img class="final-cta__mask" src={`${baseUrl}images/neon-final-cta-mask.svg`} alt="" width="1440" height="160" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>

  <div class="container final-cta__content">
    <div class="final-cta__copy">
      <h2
        id="final-cta-title"
        class="final-cta__title"
        data-scroll-reveal="final-cta-title"
        style="--final-cta-reveal-y: 20px; --final-cta-reveal-delay-mobile: 0ms; --final-cta-reveal-delay-desktop: 850ms"
      ><span>Seu próximo passo</span>{' '}<span>começa aqui.</span></h2>
      <p
        class="final-cta__description"
        data-scroll-reveal="final-cta-description"
        style="--final-cta-reveal-y: 20px; --final-cta-reveal-delay-mobile: 150ms; --final-cta-reveal-delay-desktop: 1000ms"
      >Comece a solicitação do seu cartão Neon.</p>
      <button
        class="final-cta__button button-interaction"
        type="button"
        data-demo-open
        aria-haspopup="dialog"
        aria-controls="demo-modal"
        data-scroll-reveal="final-cta-button"
        style="--final-cta-reveal-y: 20px; --final-cta-reveal-delay-mobile: 300ms; --final-cta-reveal-delay-desktop: 1150ms"
      >Começar solicitação</button>
      <p class="final-cta__legal">Crédito sujeito à análise. Estudo independente de portfólio.</p>
    </div>
  </div>
</section>

<script>
  import { initScrollReveal } from '../scripts/scroll-reveal';

  const photoRevealTargets = document.querySelectorAll<HTMLElement>(
    '.final-cta__mobile-reveal, .final-cta__desktop-reveal',
  );

  photoRevealTargets.forEach((target) => {
    const images = Array.from(target.querySelectorAll<HTMLImageElement>('img'));

    const decodeImage = (image: HTMLImageElement) =>
      new Promise<void>((resolve) => {
        const decode = () => {
          if (image.naturalWidth === 0) {
            console.error(`Unable to load Final CTA image: ${image.currentSrc || image.src}`);
            resolve();
            return;
          }

          image.decode().then(resolve, (error: unknown) => {
            console.error(`Unable to decode Final CTA image: ${image.currentSrc || image.src}`, error);
            resolve();
          });
        };

        if (image.complete) {
          decode();
          return;
        }

        image.addEventListener('load', decode, { once: true });
        image.addEventListener('error', () => {
          console.error(`Unable to load Final CTA image: ${image.currentSrc || image.src}`);
          resolve();
        }, { once: true });
      });

    void Promise.all(images.map(decodeImage)).then(() => {
      target.dataset.assetsReady = 'true';
    });
  });

  document.documentElement.classList.add('has-final-cta-assets');
  initScrollReveal();
</script>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    min-height: 835px;
    padding-top: 62px;
    background: linear-gradient(158.4406911444deg, var(--color-brand) 28.332%, var(--color-accent) 140.6%);
    color: var(--color-text-inverse);
    font-family: var(--font-family-base);
    font-optical-sizing: none;
    font-variation-settings: "opsz" 14;
  }

  /* Reserva a fotografia abaixo do texto; a seção pode crescer com zoom. */
  .final-cta::after {
    content: "";
    display: block;
    height: calc(576 / 390 * 100cqw);
  }

  .final-cta__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .final-cta__mobile-art {
    position: absolute;
    left: calc(-27 / 390 * 100%);
    bottom: calc(-42 / 390 * 100cqw);
    width: calc(443 / 390 * 100%);
    aspect-ratio: 443 / 978;
  }

  .final-cta__mobile-reveal {
    position: absolute;
    inset: 0;
  }

  .final-cta__mobile-reveal img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  :global(html.has-scroll-reveal) .final-cta [data-scroll-reveal]:not([data-scroll-revealed="true"]) {
    opacity: 0;
    transform: translate3d(0, var(--final-cta-reveal-y, 20px), 0);
  }

  .final-cta [data-scroll-reveal][data-scroll-revealed="true"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity var(--final-cta-reveal-duration, 750ms) cubic-bezier(0.22, 1, 0.36, 1) var(--final-cta-reveal-delay, 0ms),
      transform var(--final-cta-reveal-duration, 750ms) cubic-bezier(0.22, 1, 0.36, 1) var(--final-cta-reveal-delay, 0ms);
  }

  :global(html.has-scroll-reveal.has-final-cta-assets) .final-cta__mobile-reveal:not([data-assets-ready="true"]),
  :global(html.has-scroll-reveal.has-final-cta-assets) .final-cta__desktop-reveal:not([data-assets-ready="true"]) {
    opacity: 0 !important;
    transform: translate3d(0, var(--final-cta-reveal-y, 24px), 0) !important;
    transition: none !important;
  }

  .final-cta__mobile-reveal[data-scroll-reveal="final-cta-mobile-photo"] {
    --final-cta-reveal-delay: 1050ms;
  }

  .final-cta__title[data-scroll-reveal],
  .final-cta__description[data-scroll-reveal],
  .final-cta__button[data-scroll-reveal] {
    --final-cta-reveal-delay: var(--final-cta-reveal-delay-mobile, 0ms);
  }

  .final-cta__desktop-art {
    display: none;
  }

  .final-cta__content {
    position: relative;
    z-index: 1;
  }

  .final-cta__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    max-width: 652px;
  }

  h2 {
    font-size: 2rem;
    line-height: 1.12;
  }

  .final-cta__description {
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  /* Mesmo acionador e tratamento de foco dos CTAs existentes. */
  .final-cta__button {
    min-height: 56px;
    max-width: 100%;
    padding: 16px 24px;
    border: 0;
    border-radius: 100px;
    background: var(--color-accent);
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    cursor: pointer;
  }

  .final-cta__button:active {
    background: #00dde3;
  }

  /* O aviso está presente apenas no frame desktop 13:2. */
  .final-cta__legal {
    display: none;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @media (min-width: 1200px) {
    .final-cta {
      min-height: 568px;
      padding-block: 140px 64px;
      background: linear-gradient(106.7046275833deg, var(--color-brand) 24.299%, var(--color-accent) 99.668%);
    }

    .final-cta::after,
    .final-cta__mobile-art {
      display: none;
    }

    /* Só a camada de arte avança 160px sobre o FAQ. Este recorte contém
       as bordas laterais sem aplicar overflow ao conteúdo ou ao FAQ. */
    .final-cta__art {
      top: -160px;
      bottom: auto;
      height: calc(100% + 160px);
    }

    .final-cta__desktop-art {
      display: block;
      position: absolute;
      left: 50%;
      top: 0;
      width: 1440px;
      height: 728px;
      transform: translateX(-50%);
    }

    .final-cta__desktop-reveal {
      position: absolute;
      inset: 0;
    }

    .final-cta__title[data-scroll-reveal],
    .final-cta__description[data-scroll-reveal],
    .final-cta__button[data-scroll-reveal] {
      --final-cta-reveal-delay: var(--final-cta-reveal-delay-desktop, 0ms);
    }

    .final-cta__desktop-photo {
      position: absolute;
      left: -69px;
      top: 0;
      width: 1509px;
      height: 728px;
      overflow: hidden;
    }

    .final-cta__desktop-photo img {
      position: absolute;
      left: -0.01021%;
      top: 0;
      width: 95.448%;
      max-width: none;
      height: auto;
    }

    .final-cta__mask {
      position: absolute;
      left: 0;
      top: 0;
      max-width: none;
    }

    .final-cta__mobile-reveal {
      display: none;
    }

    .final-cta__copy {
      gap: 0;
    }

    h2 {
      max-width: 652px;
      font-size: 3.25rem;
    }

    h2 span {
      display: block;
    }

    .final-cta__description {
      margin-top: 16px;
      font-size: 1.3125rem;
    }

    .final-cta__button {
      margin-top: 32px;
      min-height: 62px;
      padding-inline: 28px;
      font-size: 1.0625rem;
    }

    .final-cta__legal {
      display: block;
      margin-top: 24px;
    }
  }
</style>
