---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DemoModal from '../components/DemoModal.astro';
import Benefits from '../components/Benefits.astro';
import Viracredito from '../components/Viracredito.astro';
import ExtraBenefits from '../components/ExtraBenefits.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <main>
    <div class="first-fold">
      <Header />
      <Hero />
    </div>
    <Benefits />
    <Viracredito />
    <ExtraBenefits />
    <Steps />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <DemoModal />
</BaseLayout>

<style>
  .first-fold {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    min-height: 900px;
    background: linear-gradient(to top, #238efa, #2698fc);
    font-optical-sizing: auto;
  }
  @media (min-width: 1200px) {
    .first-fold {
      min-height: 800px;
      background: #0d529f;
    }
  }
</style>
