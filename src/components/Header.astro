---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={baseUrl} aria-label="Neon — página inicial">
      <picture>
        <source media="(min-width: 1200px)" srcset={`${baseUrl}icons/neon-logo-desktop.svg`} width="145" height="32.2222" />
        <img src={`${baseUrl}icons/neon-logo-mobile.svg`} alt="Neon" width="104" height="23" />
      </picture>
    </a>
    <button class="header__cta button-interaction" type="button" data-demo-open aria-haspopup="dialog" aria-controls="demo-modal">
      Solicitar cartão
    </button>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 1;
  }
  .header__inner {
    min-height: 78px;
    padding-block: 17px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .header__brand {
    display: flex;
    align-items: flex-start;
    padding-top: 8px;
    min-height: 44px;
    flex-shrink: 0;
  }
  .header__cta {
    min-height: 44px;
    width: 149px;
    max-width: 100%;
    padding: 12px 17px;
    border: 0;
    border-radius: 100px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    cursor: pointer;
  }
  .header__cta:active {
    box-shadow: inset 0 0 0 2px var(--color-border);
  }
  @media (min-width: 1200px) {
    .header__inner {
      min-height: 104px;
      padding-block: 24px 30px;
    }
    .header__brand {
      min-height: 49px;
      padding-top: 10px;
    }
    .header__cta {
      width: auto;
      min-width: 145px;
      min-height: 49px;
      padding: 16px;
      font-size: 0.9375rem;
    }
  }
</style>
